{
  "schema_version": 1,
  "product": "ZainChecker",
  "config_type": "installer",
  "target_version": "1.4.0",
  "license_file": "license.json",
  "license_validation": {
    "format": "original-customer-map",
    "required_fields_per_customer": ["active", "expires"],
    "activation_required": true,
    "online_validation_required": true
  },
  "installation": {
    "per_user": true,
    "administrator_required": false,
    "required_components": [
      "ZainChecker.exe",
      "License.ps1",
      "Launcher.ps1",
      "Run_ZainChecker.ps1",
      "Launch_ZainChecker.vbs",
      "EdgeRepair.ps1"
    ],
    "edge_driver": {
      "source": "https://msedgedriver.microsoft.com/",
      "require_version_compatibility": true,
      "require_valid_authenticode_signature": true
    }
  },
  "implementation_status": "implemented_in_dev_build_pending_clean_machine_validation"
}
