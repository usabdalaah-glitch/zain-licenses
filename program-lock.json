{
  "schema_version": 1,
  "product": "ZainChecker",
  "config_type": "program-lock",
  "license_file": "license.json",
  "validation": {
    "format": "original-customer-map",
    "require_active_license": true,
    "enforce_expiration_date": true,
    "bind_activation_code_to_customer": true
  },
  "connectivity": {
    "online_validation_required": true,
    "offline_grace": {
      "enabled": true,
      "duration_days": 3,
      "activation_rule": "previous_successful_online_validation_required",
      "clock_rollback_detection_minutes": 5,
      "state_protection": "Windows_DPAPI_CurrentUser"
    }
  },
  "security": {
    "private_signing_key_location": "not_used_by_original_customer_map_format",
    "embed_private_key_in_client": false,
    "publish_private_key_to_repository": false
  },
  "implementation_status": "implemented_in_license_ps1_pending_offline_behavior_tests"
}
